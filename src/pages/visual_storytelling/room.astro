          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0014.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0015.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0016.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0017.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0018.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0019.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0020.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0021.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0022.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0023.jpg',
        ];
        function showRoom(index) {
          roomIndex = index;
          roomModalImg.src = roomImages[roomIndex];
        }
        roomBtns.forEach((btn, index) => {
          btn.addEventListener('click', () => {
            showRoom(index);
            roomModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          });
        });
        roomPrevBtn.addEventListener('click', () => {
          if (roomIndex > 0) {
            showRoom(roomIndex - 1);
          }
        });
        roomNextBtn.addEventListener('click', () => {
          if (roomIndex < roomImages.length - 1) {
            showRoom(roomIndex + 1);
          }
        });
        document.getElementById('close-room-gallery-modal').addEventListener('click', () => {
          roomModal.classList.add('hidden');
          document.body.style.overflow = 'auto';
        });
        roomModal.addEventListener('click', (e) => {
          if (e.target === roomModal) {
            roomModal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });
        document.addEventListener('keydown', (e) => {
          if (!roomModal.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              roomModal.classList.add('hidden');
              document.body.style.overflow = 'auto';
            } else if (e.key === 'ArrowLeft' && roomIndex > 0) {
              showRoom(roomIndex - 1);
            } else if (e.key === 'ArrowRight' && roomIndex < roomImages.length - 1) {
              showRoom(roomIndex + 1);
            }
          }
        });
      });
    </script>
