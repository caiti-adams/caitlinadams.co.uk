        const roomModalImg = document.getElementById('room-gallery-modal-img');
        const roomPrevBtn = document.getElementById('room-gallery-prev-btn');
        const roomNextBtn = document.getElementById('room-gallery-next-btn');
        let roomIndex = 0;
        const roomImages = [
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0001.jpg',
          '/assets/images/visual_storytelling/visual_art/room/art project - room_page-0002.jpg',
