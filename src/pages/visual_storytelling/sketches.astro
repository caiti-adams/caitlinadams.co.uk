---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Room - Caitlin Adams</title>
    <meta name="description" content="Visual Art - Room by Caitlin Adams." />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
  </head>
  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"></div>
      <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"></div>
    </div>
    <main class="flex-1 relative z-10">
      <Navigation />
      <section class="relative z-20 max-w-4xl mx-auto mt-12 sm:mt-24 mb-12 px-4 sm:px-7 lg:px-0">
        <div class="relative z-20 w-full mx-auto lg:mx-0">
          <h1 class="text-3xl font-bold tracking-tight text-pink-400 dark:text-pink-300 sm:text-4xl lg:text-5xl mb-8">Sketches</h1>
          <p class="mt-4 text-lg leading-7 text-neutral-600 dark:text-neutral-400">Visual Art by Caitlin Adams</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-8 mt-8">
            <button class="sketch-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square" data-img="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0002.jpg">
              <img src="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0002.jpg" alt="Sketch 1" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </button>
            <button class="sketch-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square" data-img="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0003.jpg">
              <img src="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0003.jpg" alt="Sketch 2" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </button>
            <button class="sketch-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square" data-img="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0004.jpg">
              <img src="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0004.jpg" alt="Sketch 3" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </button>
            <button class="sketch-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square" data-img="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0005.jpg">
              <img src="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0005.jpg" alt="Sketch 4" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </button>
          </div>
            <!-- Sketches Gallery Modal -->
            <div id="sketches-gallery-modal" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center p-4">
              <button id="close-sketches-gallery-modal" class="absolute top-4 right-4 text-white hover:text-pink-400 transition-colors z-10">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
              <button id="sketches-gallery-prev-btn" class="absolute left-4 text-white hover:text-pink-400 transition-colors z-10">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <button id="sketches-gallery-next-btn" class="absolute right-4 text-white hover:text-pink-400 transition-colors z-10">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
              <img id="sketches-gallery-modal-img" src="" alt="Full size sketch" class="max-w-full max-h-full object-contain" />
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Sketches Gallery modal logic
        const sketchBtns = document.querySelectorAll('.sketch-img-btn');
        const sketchModal = document.getElementById('sketches-gallery-modal');
        const sketchModalImg = document.getElementById('sketches-gallery-modal-img');
        const sketchPrevBtn = document.getElementById('sketches-gallery-prev-btn');
        const sketchNextBtn = document.getElementById('sketches-gallery-next-btn');
        let sketchIndex = 0;
        const sketchImages = [
          '/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0002.jpg',
          '/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0003.jpg',
          '/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0004.jpg',
          '/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0005.jpg',
        ];
        function showSketch(index) {
          sketchIndex = index;
          sketchModalImg.src = sketchImages[sketchIndex];
        }
        sketchBtns.forEach((btn, index) => {
          btn.addEventListener('click', () => {
            showSketch(index);
            sketchModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          });
        });
        sketchPrevBtn.addEventListener('click', () => {
          if (sketchIndex > 0) {
            showSketch(sketchIndex - 1);
          }
        });
        sketchNextBtn.addEventListener('click', () => {
          if (sketchIndex < sketchImages.length - 1) {
            showSketch(sketchIndex + 1);
          }
        });
        document.getElementById('close-sketches-gallery-modal').addEventListener('click', () => {
          sketchModal.classList.add('hidden');
          document.body.style.overflow = 'auto';
        });
        sketchModal.addEventListener('click', (e) => {
          if (e.target === sketchModal) {
            sketchModal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });
        document.addEventListener('keydown', (e) => {
          if (!sketchModal.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              sketchModal.classList.add('hidden');
              document.body.style.overflow = 'auto';
            } else if (e.key === 'ArrowLeft' && sketchIndex > 0) {
              showSketch(sketchIndex - 1);
            } else if (e.key === 'ArrowRight' && sketchIndex < sketchImages.length - 1) {
              showSketch(sketchIndex + 1);
            }
          }
        });
      });
    </script>
  </body>
</html>
