---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Visual Storytelling - Caitlin Adams</title>
    <meta name="description" content="Visual storytelling portfolio" />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    <style>
    </style>
  </head>
  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"
      >
      </div>
      <div
        class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"
      >
      </div>
    </div>

    <main class="flex-1 relative z-10">
      <Navigation />
      <section class="relative z-20 w-[896px] mx-auto mt-24">
        <h2 class="text-2xl font-bold tracking-tight text-pink-400 dark:text-pink-300 sm:text-3xl lg:text-4xl mb-8">Photography</h2>
        <div class="mb-12 flex flex-col items-center">
          <a href="/visual_storytelling/gallery1" class="w-[384px] bg-gray-100 dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden block hover:ring-2 hover:ring-pink-400 transition-all">
            <img src="/assets/images/visual_storytelling/photography/gallery1/20220918_133118.jpg" alt="Gallery 1" class="w-full h-[240px] object-cover" />
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Gallery 1</h3>
            </div>
          </a>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-pink-400 dark:text-pink-300 sm:text-3xl lg:text-4xl mb-8">Visual Art</h2>
        <div class="mb-12 grid grid-cols-1 sm:grid-cols-2 gap-8 place-items-center">
          <a href="/visual_storytelling/room" class="w-[384px] bg-gray-100 dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden block hover:ring-2 hover:ring-pink-400 transition-all">
            <img src="/assets/images/visual_storytelling/visual_art/room/art%20project%20-%20room_page-0001.jpg" alt="Room" class="w-full h-[240px] object-cover" />
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Room</h3>
            </div>
          </a>
          <a href="/visual_storytelling/matric" class="w-[384px] bg-gray-100 dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden block hover:ring-2 hover:ring-pink-400 transition-all">
            <img src="/assets/images/visual_storytelling/visual_art/matric/final%20matric%20project_page-0001.jpg" alt="Matric" class="w-full h-[240px] object-cover" />
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Matric</h3>
            </div>
          </a>
          <a href="/visual_storytelling/sketches" class="w-[384px] bg-gray-100 dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden block hover:ring-2 hover:ring-pink-400 transition-all">
            <img src="/assets/images/visual_storytelling/visual_art/sketches/Art%20+%20Sketches_page-0002.jpg" alt="Sketches" class="w-full h-[240px] object-cover" />
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">Sketches</h3>
            </div>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
