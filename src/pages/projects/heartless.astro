---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Heartless - Caitlin Adams</title>
    <meta name="description" content="A hyper-feminine psychological horror exploring the cost of perfection." />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    <style>
      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div
        class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"
      >
      </div>
      <div
        class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"
      >
      </div>
    </div>

    <main class="flex-1 relative z-10">
      <Navigation />
      <section class="relative z-20 max-w-4xl mx-auto mt-24 mb-12 px-7 lg:px-0">
        <div class="relative z-20 w-full mx-auto lg:mx-0">
          <h1
            class="text-3xl font-bold tracking-tight text-pink-400 dark:text-pink-300 sm:text-4xl lg:text-5xl"
          >
            Heartless
          </h1>
          <p
            class="mt-4 text-lg leading-7 text-neutral-600 dark:text-neutral-400"
          >
            A hyper-feminine psychological horror exploring the cost of perfection
          </p>
          
          <!-- Tab Navigation -->
          <div class="mt-8 border-b border-neutral-200 dark:border-neutral-700">
            <nav class="flex space-x-8">
              <button
                class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors active"
                data-tab="overview"
              >
                Overview
              </button>
              <button
                class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                data-tab="storyboards"
              >
                Storyboards
              </button>
              <button
                class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                data-tab="moodboard"
              >
                Moodboards
              </button>
            </nav>
          </div>

          <!-- Tab Content -->
          <div class="mt-8">
            <!-- Overview Tab -->
            <div class="tab-content" data-tab-content="overview">
              <div class="prose dark:prose-invert max-w-none">
                <p class="text-neutral-600 dark:text-neutral-400 italic">
                  A social media influencer wraps up filming a video for her channel, before proceeding to her lengthy and intense beauty routine. She ends her routine with a dark and disturbing secret.
                </p>

                <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-8">Synopsis</h2>
                
                <p class="text-neutral-600 dark:text-neutral-400">
                  Stacy Hart is a famous lifestyle influencer on social media, amassing millions of followers due to her beauty. Through her content, she shares her wellness habits and routines, marketing herself as transparent and selling curated intimacy between creator and audience, convincing them that she keeps no secrets and that criticism has no effect on her.
                </p>

                <p class="text-neutral-600 dark:text-neutral-400">
                  As Stacy closes her laptop after filming a video, she allows her online persona to drop along with her fake smile. She begins her beauty routine alone, her actions becoming slower, more deliberate, and obsessive, revealing a ritualistic approach to maintaining her appearance. She practices yoga, has a bath, grooms, and does her makeup with an increasing intensity that betrays her calm exterior.
                </p>

                <p class="text-neutral-600 dark:text-neutral-400">
                  Although Stacy markets authenticity, she hides the most extreme part of her routine from her audience. Online hate comments linger in her mind, fuelling a fear of aging, judgment, and loss of relevance. She believes that her beauty is truly maintained through a violent private ritual: consuming the hearts of those who criticise her online.
                </p>

                <p class="text-neutral-600 dark:text-neutral-400">
                  In the final scene, Stacy prepares the last step of her routine. She places a cloche on the table, a cruel tweet targeted at her taped to its surface. The cloche is lifted to reveal the heart of the user who made that comment, ready for consumption. Before indulging, she posts a message to her followers, claiming that her only secret is a "good diet". As she brings the fork to her mouth, she smiles. Her ritual is now complete for the day.
                </p>
              </div>
            </div>

            <!-- Storyboards Tab -->
            <div class="tab-content hidden" data-tab-content="storyboards">
              <div class="max-w-none">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
                  <button
                    class="storyboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/storyboard_1_rotated-1.png"
                  >
                    <img
                      src="/assets/images/projects/storyboard_1_rotated-1.png"
                      alt="Storyboard 1"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="storyboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/storyboard_2_rotated-1.png"
                  >
                    <img
                      src="/assets/images/projects/storyboard_2_rotated-1.png"
                      alt="Storyboard 2"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="storyboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/storyboard_3_rotated-1.png"
                  >
                    <img
                      src="/assets/images/projects/storyboard_3_rotated-1.png"
                      alt="Storyboard 3"
                      class="w-full h-full object-cover"
                    />
                  </button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
                  <button
                    class="storyboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/storyboard_4_rotated-1.png"
                  >
                    <img
                      src="/assets/images/projects/storyboard_4_rotated-1.png"
                      alt="Storyboard 4"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="storyboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/storyboard_5_rotated-1.png"
                  >
                    <img
                      src="/assets/images/projects/storyboard_5_rotated-1.png"
                      alt="Storyboard 5"
                      class="w-full h-full object-cover"
                    />
                  </button>
                </div>

                <!-- Storyboard Modal -->
                <div
                  id="storyboard-modal"
                  class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center p-4"
                >
                  <button
                    id="close-storyboard-modal"
                    class="absolute top-4 right-4 text-white hover:text-pink-400 transition-colors z-10"
                  >
                    <svg
                      class="w-8 h-8"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                      ></path>
                    </svg>
                  </button>
                  
                  <button
                    id="storyboard-prev-btn"
                    class="absolute left-4 text-white hover:text-pink-400 transition-colors z-10"
                  >
                    <svg
                      class="w-10 h-10"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"
                      ></path>
                    </svg>
                  </button>
                  
                  <button
                    id="storyboard-next-btn"
                    class="absolute right-4 text-white hover:text-pink-400 transition-colors z-10"
                  >
                    <svg
                      class="w-10 h-10"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      ></path>
                    </svg>
                  </button>
                  
                  <img
                    id="storyboard-modal-img"
                    src=""
                    alt="Full size storyboard"
                    class="max-w-full max-h-full object-contain"
                  />
                </div>
              </div>
            </div>

            <!-- Moodboard Tab -->
            <div class="tab-content hidden" data-tab-content="moodboard">
              <div class="max-w-none">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  <button
                    class="moodboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/Slide2.PNG"
                  >
                    <img
                      src="/assets/images/projects/Slide2.PNG"
                      alt="Moodboard Slide 2"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="moodboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/Slide3.PNG"
                  >
                    <img
                      src="/assets/images/projects/Slide3.PNG"
                      alt="Moodboard Slide 3"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="moodboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/Slide4.PNG"
                  >
                    <img
                      src="/assets/images/projects/Slide4.PNG"
                      alt="Moodboard Slide 4"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="moodboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/Slide5.PNG"
                  >
                    <img
                      src="/assets/images/projects/Slide5.PNG"
                      alt="Moodboard Slide 5"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="moodboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/Slide6.PNG"
                  >
                    <img
                      src="/assets/images/projects/Slide6.PNG"
                      alt="Moodboard Slide 6"
                      class="w-full h-full object-cover"
                    />
                  </button>
                  <button
                    class="moodboard-img-btn bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow cursor-pointer aspect-square"
                    data-img="/assets/images/projects/Slide7.PNG"
                  >
                    <img
                      src="/assets/images/projects/Slide7.PNG"
                      alt="Moodboard Slide 7"
                      class="w-full h-full object-cover"
                    />
                  </button>
                </div>

                <!-- Moodboard Modal -->
                <div
                  id="moodboard-modal"
                  class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center p-4"
                >
                  <button
                    id="close-moodboard-modal"
                    class="absolute top-4 right-4 text-white hover:text-pink-400 transition-colors z-10"
                  >
                    <svg
                      class="w-8 h-8"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                      ></path>
                    </svg>
                  </button>
                  
                  <button
                    id="moodboard-prev-btn"
                    class="absolute left-4 text-white hover:text-pink-400 transition-colors z-10"
                  >
                    <svg
                      class="w-10 h-10"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"
                      ></path>
                    </svg>
                  </button>
                  
                  <button
                    id="moodboard-next-btn"
                    class="absolute right-4 text-white hover:text-pink-400 transition-colors z-10"
                  >
                    <svg
                      class="w-10 h-10"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      ></path>
                    </svg>
                  </button>
                  
                  <img
                    id="moodboard-modal-img"
                    src=""
                    alt="Full size moodboard"
                    class="max-w-full max-h-full object-contain"
                  />
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 mb-8">
            <a
              href="/assets/images/projects/heartless concept.pdf"
              download
              class="inline-flex items-center gap-2 px-6 py-3 bg-pink-400 dark:bg-pink-300 text-white dark:text-neutral-900 rounded-lg hover:bg-pink-500 dark:hover:bg-pink-400 transition-colors font-medium"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Download Heartless as a PDF
            </a>
          </div>

          <div class="mt-8">
            <a
              href="/projects/"
              class="inline-flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 19l-7-7m0 0l7-7m-7 7h18"
                ></path>
              </svg>
              Back to Projects
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabContents = document.querySelectorAll('.tab-content');

        tabButtons.forEach(button => {
          button.addEventListener('click', () => {
            const tabName = button.getAttribute('data-tab');

            // Remove active state from all buttons
            tabButtons.forEach(btn => {
              btn.classList.remove('active', 'border-pink-400', 'dark:border-pink-300', 'text-pink-400', 'dark:text-pink-300');
              btn.classList.add('border-transparent', 'text-neutral-500', 'dark:text-neutral-400', 'hover:text-neutral-700', 'dark:hover:text-neutral-300', 'hover:border-neutral-300', 'dark:hover:border-neutral-600');
            });

            // Add active state to clicked button
            button.classList.remove('border-transparent', 'text-neutral-500', 'dark:text-neutral-400', 'hover:text-neutral-700', 'dark:hover:text-neutral-300', 'hover:border-neutral-300', 'dark:hover:border-neutral-600');
            button.classList.add('active', 'border-pink-400', 'dark:border-pink-300', 'text-pink-400', 'dark:text-pink-300');

            // Hide all tab contents
            tabContents.forEach(content => {
              content.classList.add('hidden');
            });

            // Show selected tab content
            const selectedContent = document.querySelector(`[data-tab-content="${tabName}"]`);
            if (selectedContent) {
              selectedContent.classList.remove('hidden');
            }
          });
        });

        // Set initial active state
        const activeButton = document.querySelector('.tab-button.active');
        if (activeButton) {
          activeButton.classList.add('border-pink-400', 'dark:border-pink-300', 'text-pink-400', 'dark:text-pink-300');
        }

        // Set inactive state for non-active buttons
        tabButtons.forEach(btn => {
          if (!btn.classList.contains('active')) {
            btn.classList.add('border-transparent', 'text-neutral-500', 'dark:text-neutral-400', 'hover:text-neutral-700', 'dark:hover:text-neutral-300', 'hover:border-neutral-300', 'dark:hover:border-neutral-600');
          }
        });

        // Storyboard modal functionality
        const storyboardModal = document.getElementById('storyboard-modal');
        const storyboardModalImg = document.getElementById('storyboard-modal-img');
        const closeStoryboardModal = document.getElementById('close-storyboard-modal');
        const storyboardPrevBtn = document.getElementById('storyboard-prev-btn');
        const storyboardNextBtn = document.getElementById('storyboard-next-btn');
        const storyboardBtns = document.querySelectorAll('.storyboard-img-btn');
        
        // Moodboard modal functionality
        const moodboardModal = document.getElementById('moodboard-modal');
        const moodboardModalImg = document.getElementById('moodboard-modal-img');
        const closeMoodboardModal = document.getElementById('close-moodboard-modal');
        const moodboardPrevBtn = document.getElementById('moodboard-prev-btn');
        const moodboardNextBtn = document.getElementById('moodboard-next-btn');
        const moodboardBtns = document.querySelectorAll('.moodboard-img-btn');
        
        const storyboardImages = Array.from(storyboardBtns).map(btn => btn.getAttribute('data-img'));
        const moodboardImages = Array.from(moodboardBtns).map(btn => btn.getAttribute('data-img'));
        
        let storyboardIndex = 0;
        let moodboardIndex = 0;

        function updateStoryboardButtons() {
          storyboardPrevBtn.style.opacity = storyboardIndex === 0 ? '0.3' : '1';
          storyboardPrevBtn.style.pointerEvents = storyboardIndex === 0 ? 'none' : 'auto';
          storyboardNextBtn.style.opacity = storyboardIndex === storyboardImages.length - 1 ? '0.3' : '1';
          storyboardNextBtn.style.pointerEvents = storyboardIndex === storyboardImages.length - 1 ? 'none' : 'auto';
        }

        function updateMoodboardButtons() {
          moodboardPrevBtn.style.opacity = moodboardIndex === 0 ? '0.3' : '1';
          moodboardPrevBtn.style.pointerEvents = moodboardIndex === 0 ? 'none' : 'auto';
          moodboardNextBtn.style.opacity = moodboardIndex === moodboardImages.length - 1 ? '0.3' : '1';
          moodboardNextBtn.style.pointerEvents = moodboardIndex === moodboardImages.length - 1 ? 'none' : 'auto';
        }

        function showStoryboard(index) {
          storyboardIndex = index;
          storyboardModalImg.src = storyboardImages[storyboardIndex];
          updateStoryboardButtons();
        }

        function showMoodboard(index) {
          moodboardIndex = index;
          moodboardModalImg.src = moodboardImages[moodboardIndex];
          updateMoodboardButtons();
        }

        // Storyboard click handlers
        storyboardBtns.forEach((btn, index) => {
          btn.addEventListener('click', () => {
            showStoryboard(index);
            storyboardModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          });
        });

        storyboardPrevBtn.addEventListener('click', () => {
          if (storyboardIndex > 0) {
            showStoryboard(storyboardIndex - 1);
          }
        });

        storyboardNextBtn.addEventListener('click', () => {
          if (storyboardIndex < storyboardImages.length - 1) {
            showStoryboard(storyboardIndex + 1);
          }
        });

        closeStoryboardModal.addEventListener('click', () => {
          storyboardModal.classList.add('hidden');
          document.body.style.overflow = 'auto';
        });

        storyboardModal.addEventListener('click', (e) => {
          if (e.target === storyboardModal) {
            storyboardModal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });

        // Moodboard click handlers
        moodboardBtns.forEach((btn, index) => {
          btn.addEventListener('click', () => {
            showMoodboard(index);
            moodboardModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          });
        });

        moodboardPrevBtn.addEventListener('click', () => {
          if (moodboardIndex > 0) {
            showMoodboard(moodboardIndex - 1);
          }
        });

        moodboardNextBtn.addEventListener('click', () => {
          if (moodboardIndex < moodboardImages.length - 1) {
            showMoodboard(moodboardIndex + 1);
          }
        });

        closeMoodboardModal.addEventListener('click', () => {
          moodboardModal.classList.add('hidden');
          document.body.style.overflow = 'auto';
        });

        moodboardModal.addEventListener('click', (e) => {
          if (e.target === moodboardModal) {
            moodboardModal.classList.add('hidden');
            document.body.style.overflow = 'auto';
          }
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
          if (!storyboardModal.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              storyboardModal.classList.add('hidden');
              document.body.style.overflow = 'auto';
            } else if (e.key === 'ArrowLeft' && storyboardIndex > 0) {
              showStoryboard(storyboardIndex - 1);
            } else if (e.key === 'ArrowRight' && storyboardIndex < storyboardImages.length - 1) {
              showStoryboard(storyboardIndex + 1);
            }
          } else if (!moodboardModal.classList.contains('hidden')) {
            if (e.key === 'Escape') {
              moodboardModal.classList.add('hidden');
              document.body.style.overflow = 'auto';
            } else if (e.key === 'ArrowLeft' && moodboardIndex > 0) {
              showMoodboard(moodboardIndex - 1);
            } else if (e.key === 'ArrowRight' && moodboardIndex < moodboardImages.length - 1) {
              showMoodboard(moodboardIndex + 1);
            }
          }
        });
      });
    </script>
  </body>
</html>
