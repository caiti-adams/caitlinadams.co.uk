                class="tab-button py-4 px-1 border-b-2 font-medium text-sm transition-colors border-transparent text-neutral-500 dark:text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-300 hover:border-neutral-300 dark:hover:border-neutral-600"
