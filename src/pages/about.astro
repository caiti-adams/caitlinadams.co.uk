---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { aboutContent } from "../config/content.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{aboutContent.meta.title}</title>
    <meta name="description" content={aboutContent.meta.description} />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    <style>
      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col bg-white dark:bg-neutral-900 transition-colors duration-300"
  >
    <div class="relative flex-grow flex flex-col">
      <div class="absolute inset-0 z-0">
        <div
          class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"
        >
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"
        >
        </div>
        <div
          class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"
        >
        </div>
      </div>

      <Navigation />
      <section class="relative z-20 w-[896px] mx-auto mt-24 mb-12">
        <div class="relative z-20 w-full mx-auto lg:mx-0">
          <h2
            class="text-2xl font-bold tracking-tight text-pink-400 dark:text-pink-300 sm:text-3xl lg:text-4xl"
          >
            {aboutContent.title}
          </h2>
          <div class="flex flex-col md:flex-row gap-8 mt-3 sm:mt-4 lg:mt-6">
            <div class="w-full flex flex-col">
              <p
                class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
              >
                {aboutContent.description}
              </p>
            </div>
          </div>
        </div>

        <div class="mt-20">
          <h2
            class="text-2xl font-bold tracking-tight text-pink-400 dark:text-pink-300 sm:text-3xl mb-8"
          >
            Headshots
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow">
              <img
                src="/assets/images/about/Caitlin-Adams-001-web-size.jpg"
                alt="Caitlin Adams Headshot"
                class="w-full h-auto object-cover"
              />
            </div>
            <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow">
              <img
                src="/assets/images/about/Caitlin-Adams-002-web-size.jpg"
                alt="Caitlin Adams Headshot"
                class="w-full h-auto object-cover"
              />
            </div>
            <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow">
              <img
                src="/assets/images/about/Caitlin-Adams-003-web-size.jpg"
                alt="Caitlin Adams Headshot"
                class="w-full h-auto object-cover"
              />
            </div>
            <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow">
              <img
                src="/assets/images/about/Caitlin-Adams-005-web-size.jpg"
                alt="Caitlin Adams Headshot"
                class="w-full h-auto object-cover"
              />
            </div>
            <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow">
              <img
                src="/assets/images/about/Caitlin-Adams-006-web-size.jpg"
                alt="Caitlin Adams Headshot"
                class="w-full h-auto object-cover"
              />
            </div>
            <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow">
              <img
                src="/assets/images/about/Caitlin-Adams-007-web-size.jpg"
                alt="Caitlin Adams Headshot"
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </section>
    </div>

    <Footer />
  </body>
</html>
